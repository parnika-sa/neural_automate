# ==========================================
# NeuralAutomate.dev - Environment Variables Template
# ==========================================

# Business Email & Sender Address
INFO_EMAIL="info@neuralautomate.dev"

# Option 1: Resend API Key (Recommended & Free 3,000 Emails/mo)
RESEND_API_KEY="re_123456789_your_resend_api_key"

# Option 2: Hostinger Webmail SMTP
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@neuralautomate.dev"
SMTP_PASS="your_smtp_password_here"

# n8n Webhook Endpoint URLs (Leave empty to trigger clearly-labeled MOCK fallback responses)
NEXT_PUBLIC_N8N_DEMO_WEBHOOK_URL=""
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK_URL=""
NEXT_PUBLIC_N8N_PAYMENT_SUCCESS_WEBHOOK_URL=""

# Razorpay LIVE Integration Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Stripe Integration Keys (International $)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_PRICE_ID_STARTER="price_starter_your_id_here"
STRIPE_PRICE_ID_GROWTH="price_growth_your_id_here"
